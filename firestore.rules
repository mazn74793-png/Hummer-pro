rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        (request.auth.token.email_verified == true && request.auth.token.email == "motaem23y@gmail.com") ||
        (request.auth.token.email == "motaem23y@gmail.com")
      );
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Users Collection
    match /users/{userId} {
      allow read, write: if isOwner(userId) || isAdmin();
    }

    // Settings, Menu, and Branches Collections (Public Read, Admin Write)
    match /settings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /menu/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /branches/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Riders Collection
    match /riders/{riderId} {
      allow read, write: if true;
    }

    // Orders Collection
    match /orders/{orderId} {
      allow read, write: if true;
    }
  }
}
